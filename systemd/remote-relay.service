$use your own relay service name for p2p

[Unit]
Description=Vismrit Remote Relay Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/remote.vismrit.tech/goServer
ExecStart=/www/wwwroot/remote.vismrit.tech/goServer/bin/remote-relay \
  -addr 0.0.0.0:46000 \
  -cert /www/server/panel/vhost/cert/remote.vismrit.tech/fullchain.pem \
  -key /www/server/panel/vhost/cert/remote.vismrit.tech/privkey.pem
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
